# R2_ENDPOINT should be your account ID based endpoint
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 Access Credentials from Cloudflare dashboard
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# R2 Bucket name
R2_BUCKET_NAME=moneyboy

# Public URL for accessing files (custom domain or R2.dev URL)
R2_PUBLIC_URL=https://moneyboy.your-domain.com
